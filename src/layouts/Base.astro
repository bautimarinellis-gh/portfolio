---
import { ClientRouter } from 'astro:transitions';
import Signature from '../components/Signature.astro';
import { altPath, langFromPath, route, ui, type Lang } from '../lib/i18n';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** night = lo personal, day = trabajo */
  theme?: 'night' | 'day';
  /** en qué punto de la noche arranca esta página (0 = recién prendido, 1 = amanece) */
  nightStart?: number;
  /** intensidad del fogón en esta página */
  fire?: number;
  current?: string;
  image?: string;
  /** idioma de la página; si no se pasa, sale de la URL (/en/… = inglés) */
  lang?: Lang;
}

const {
  title,
  description,
  theme = 'night',
  nightStart = 0,
  fire = 1,
  current = '',
  image,
  lang = langFromPath(Astro.url.pathname),
} = Astro.props;

const t = ui[lang];
const desc = description ?? t.siteDescription;
const other = altPath(Astro.url.pathname);
const otherLang: Lang = lang === 'es' ? 'en' : 'es';

const fullTitle = title ? `${title} — Bautista Marinelli Scaglia` : 'Bautista Marinelli Scaglia';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? '/og.png', Astro.site);

const personal = [
  { href: route('blog', lang), label: t.nav.blog, key: 'blog' },
  { href: route('shelf', lang), label: t.nav.shelf, key: 'estante' },
];
---

<!doctype html>
<html lang={lang} data-theme={theme} data-night-start={nightStart} data-fire={fire}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content={theme === 'day' ? '#efe8da' : '#07080c'} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={ogImage} />
    {!image && <meta property="og:image:width" content="1200" />}
    {!image && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={image ? fullTitle : t.ogAlt} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_AR'} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Blog — Bautista Marinelli Scaglia" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={otherLang} href={new URL(other, Astro.site)} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..600,0..100;1,9..144,300..600,0..100&family=Newsreader:ital,opsz,wght@0,6..72,300..500;1,6..72,300..500&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // Oculta lo que Motion va a revelar. Si algo falla, a los 2.5 s se muestra igual.
      document.documentElement.classList.add('js');
      setTimeout(function () {
        if (!window.__skyReady) document.documentElement.classList.remove('js');
      }, 2500);
    </script>

    <ClientRouter fallback="swap" />
  </head>

  <body>
    <!-- El cielo persiste entre páginas: no se reinicia al navegar -->
    <div class="sky" aria-hidden="true" transition:persist="sky">
      <canvas id="sky-back"></canvas>
      <div class="firelight" data-fire-target></div>
      <div class="dawn"></div>
    </div>
    <canvas class="embers" id="sky-front" aria-hidden="true" transition:persist="embers"></canvas>

    <a class="skip" href="#contenido">{t.skip}</a>

    <header class="site-header">
      <nav class="nav" aria-label="Principal">
        <a href={route('home', lang)} class="mark" aria-label={lang === 'en' ? 'Home' : 'Inicio'}>bms<span class="mark-dot"></span></a>
        <button type="button" class="nav-toggle" aria-expanded="false" aria-controls="nav-links" data-open={t.menu} data-close={t.close}>{t.menu}</button>
        <ul class="nav-links" id="nav-links">
          {
            personal.map((l) => (
              <li>
                <a href={l.href} aria-current={current === l.key ? 'page' : undefined}>
                  {l.label}
                </a>
              </li>
            ))
          }
          <li class="nav-boring">
            <a href={route('work', lang)} aria-current={current === 'trabajo' ? 'page' : undefined}>{t.nav.work}</a>
          </li>
          <li class="nav-lang">
            <a href={other} hreflang={otherLang} lang={otherLang} aria-label={t.langSwitchLabel}>{t.langSwitch}</a>
          </li>
        </ul>
      </nav>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="site-footer wrap">
      <div class="footer-left">
        <Signature />
        {
          theme === 'day' && (
            <p class="footer-line">
              <a href={route('home', lang)}>{t.backToNight}</a>
            </p>
          )
        }
      </div>
      <p>
        © {new Date().getFullYear()} Bautista Marinelli Scaglia · Rosario
      </p>
    </footer>

    <script>
      import { setupSite } from '../scripts/site.js';
      setupSite();
    </script>
  </body>
</html>
