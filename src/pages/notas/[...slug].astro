---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { published, formatDate } from '../../lib/content';

export async function getStaticPaths() {
  const notas = await published('notas');
  return notas.map((n) => ({ params: { slug: n.id }, props: { nota: n } }));
}

const { nota } = Astro.props;
const { Content } = await render(nota);
---

<Base title={nota.data.title} current="bitacora" nightStart={0.35} fire={0.5}>
  <header class="page-head wrap">
    <p class="page-kicker">{formatDate(nota.data.date)}</p>
    <h1 class="page-title">{nota.data.title}</h1>
  </header>
  <article class="wrap">
    {nota.data.draft && <p class="log-draft" style="display:inline-block;margin-bottom:1.5rem">borrador: no se publica</p>}
    <div class="prose reveal"><Content /></div>
    <p style="margin-top:3rem"><a class="link-quiet" href="/bitacora">← bitácora</a></p>
  </article>
</Base>
