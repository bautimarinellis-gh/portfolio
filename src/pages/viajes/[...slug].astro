---
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Gallery, { type Photo } from '../../components/Gallery.tsx';
import { published, formatDate } from '../../lib/content';

export async function getStaticPaths() {
  const viajes = await published('viajes');
  return viajes.map((v) => ({ params: { slug: v.id }, props: { viaje: v } }));
}

const { viaje } = Astro.props;
const { Content } = await render(viaje);
const d = viaje.data;

// versiones optimizadas: grilla (responsive) y grande (lightbox)
const photos: Photo[] = await Promise.all(
  d.photos.map(async (p) => {
    const grid = await getImage({ src: p.src, widths: [640, 1000, 1500], format: 'webp' });
    const full = await getImage({ src: p.src, width: 2000, format: 'webp' });
    return {
      src: grid.src,
      srcset: grid.srcSet.attribute,
      full: full.src,
      width: p.src.width,
      height: p.src.height,
      alt: p.alt,
      caption: p.caption,
    };
  }),
);
---

<Base title={d.place} description={d.summary ?? d.title} current="viajes" nightStart={0.25} fire={0.5} image={d.cover.src}>
  <header class="trip-hero">
    <Image src={d.cover} alt="" widths={[800, 1400, 2200]} sizes="100vw" loading="eager" class="trip-cover" />
    <div class="trip-hero-text wrap">
      <p class="mono">
        {formatDate(d.date)}{d.coords && <> · {d.coords}</>}
      </p>
      <h1 class="page-title">{d.place}</h1>
      <p class="page-lede">{d.title}</p>
    </div>
  </header>

  <article class="wrap trip-body">
    {d.draft && <p class="log-draft" style="display:inline-block;margin-bottom:1.5rem">borrador: no se publica</p>}
    <div class="prose reveal">
      <Content />
    </div>
    {photos.length > 0 && <Gallery client:visible photos={photos} />}
    <p class="trip-back"><a class="link-quiet" href="/viajes">← todos los viajes</a></p>
  </article>
</Base>

<style>
  .trip-hero {
    position: relative;
    height: min(92svh, 900px);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }

  .trip-hero :global(.trip-cover) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85) brightness(0.8);
  }

  .trip-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(7, 8, 12, 0.5) 0%, transparent 30%, transparent 50%, rgba(7, 8, 12, 0.95) 100%);
  }

  .trip-hero-text {
    position: relative;
    z-index: 1;
    padding-bottom: clamp(2rem, 6vw, 4rem);
  }

  .trip-hero-text .mono {
    color: var(--fg-dim);
    margin-bottom: 1rem;
  }

  .trip-body {
    padding-top: clamp(2.5rem, 6vw, 4rem);
  }

  .trip-back {
    margin-top: 3rem;
  }

  :global(.gallery) {
    margin-top: clamp(2.5rem, 6vw, 4rem);
    display: grid;
    gap: clamp(1.2rem, 3vw, 2.4rem);
  }

  :global(.g-item) {
    max-width: 100%;
  }

  :global(.g-item--tall) {
    max-width: min(560px, 100%);
    justify-self: center;
  }

  :global(.g-open) {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: #0c0e14;
    cursor: zoom-in;
  }

  :global(.g-open img) {
    width: 100%;
    height: auto;
  }

  :global(.g-item figcaption) {
    margin-top: 0.6rem;
    font-style: italic;
    font-size: 0.95rem;
    color: var(--fg-dim);
  }

  :global(.lightbox) {
    position: fixed;
    inset: 0;
    z-index: 500;
    display: grid;
    place-items: center;
    padding: clamp(16px, 4vw, 48px);
    background: rgba(4, 5, 8, 0.94);
    cursor: zoom-out;
  }

  :global(.lb-figure) {
    cursor: default;
    max-width: min(1400px, 100%);
  }

  :global(.lb-figure img) {
    max-height: 82svh;
    width: auto;
    margin: 0 auto;
  }

  :global(.lb-figure figcaption) {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.8rem;
    font-style: italic;
    color: var(--fg-dim);
  }

  :global(.lb-nav),
  :global(.lb-close) {
    position: absolute;
    background: none;
    border: 0;
    cursor: pointer;
    color: var(--fg-dim);
    font-family: var(--mono);
    transition: color 0.3s;
  }

  :global(.lb-nav:hover),
  :global(.lb-close:hover) {
    color: var(--fg);
  }

  :global(.lb-nav) {
    top: 50%;
    font-size: 1.4rem;
    padding: 1rem;
  }

  :global(.lb-prev) {
    left: 0.5rem;
  }

  :global(.lb-next) {
    right: 0.5rem;
  }

  :global(.lb-close) {
    top: 1rem;
    right: 1.2rem;
    font-size: 0.8rem;
  }
</style>
