---
import Base from '../layouts/Base.astro';
import YouTube from '../components/YouTube.astro';
import { published, byDateDesc, formatDate } from '../lib/content';

const videos = (await published('movimiento')).sort(byDateDesc);
---

<Base title="Movimiento" current="movimiento" nightStart={0.4} fire={0.5}>
  <header class="page-head wrap">
    <p class="page-kicker">03:20</p>
    <h1 class="page-title">Movimiento</h1>
    <p class="page-lede">Lo que entreno. Sin rutina para vender: solo el registro.</p>
  </header>

  <section class="wrap videos">
    {videos.length === 0 && <p class="empty">Todavía no subí nada.</p>}
    {
      videos.map((v) => (
        <article class="video reveal" id={v.id}>
          <YouTube id={v.data.youtubeId} title={v.data.title} />
          <div class="video-text">
            <p class="mono dim">
              {formatDate(v.data.date)} {v.data.draft && <span class="log-draft">borrador</span>}
            </p>
            <h2>{v.data.title}</h2>
            {v.data.note && <p class="dim">{v.data.note}</p>}
          </div>
        </article>
      ))
    }
  </section>
</Base>

<style>
  .videos {
    display: grid;
    gap: clamp(3rem, 7vw, 5rem);
  }

  .video {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    align-items: end;
    gap: clamp(1.2rem, 4vw, 3rem);
    scroll-margin-top: 6rem;
  }

  .video h2 {
    margin: 0.5rem 0 0.4rem;
    font-family: var(--serif-display);
    font-weight: 360;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.2rem);
    line-height: 1.1;
    font-variation-settings: "SOFT" 60;
  }

  @media (max-width: 760px) {
    .video {
      grid-template-columns: 1fr;
    }
  }
</style>
