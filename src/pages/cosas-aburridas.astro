---
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';

const proyectos = (await getCollection('proyectos')).sort((a, b) => a.data.order - b.data.order);
const experiencia = (await getCollection('experiencia')).sort((a, b) => a.data.order - b.data.order);

const proyectosRender = await Promise.all(proyectos.map(async (p) => ({ p, Content: (await render(p)).Content })));
const experienciaRender = await Promise.all(experiencia.map(async (e) => ({ e, Content: (await render(e)).Content })));

const stack = [
  { k: 'Backend', v: 'C#, .NET Core, ASP.NET, Entity Framework, Node.js, Express' },
  { k: 'Frontend', v: 'React, HTML, CSS, JavaScript' },
  { k: 'Datos', v: 'SQL Server, MongoDB' },
  { k: 'Herramientas', v: 'Git, GitHub, Postman' },
];
---

<Base
  title="Cosas aburridas"
  description="Laburo, estudios y proyectos de Bautista Marinelli Scaglia: estudiante de último año de Ingeniería en Sistemas en Rosario. Backend con .NET y Node, bases de datos y análisis funcional."
  theme="day"
  current="aburridas"
>
  <header class="page-head wrap boring-head">
    <div>
      <h1 class="page-title">Cosas <em>aburridas</em></h1>
      <p class="page-lede">
        Laburo, estudios y proyectos. Si llegaste por el CV, este es el lugar.
      </p>
      <div class="links-row boring-actions">
        <a href="/cv/CV_BautistaMarinelli_ES.pdf" target="_blank" rel="noopener" class="link-quiet">Descargar CV <small>pdf</small></a>
        <a href="mailto:bautimarinelli100@gmail.com" class="link-quiet">bautimarinelli100@gmail.com</a>
        <a href="https://www.linkedin.com/in/bautistamarinelliscaglia/" target="_blank" rel="noopener" class="link-quiet">LinkedIn</a>
        <a href="https://github.com/bautimarinellis-gh" target="_blank" rel="noopener" class="link-quiet">GitHub</a>
      </div>
    </div>
  </header>

  <section class="section wrap" id="resumen">
    <header class="section-head reveal"><span class="hour">01</span><h2>En resumen</h2></header>
    <div class="prose reveal">
      <p>
        Tengo 23 años y estoy en el último año de Ingeniería en Sistemas en la Universidad Abierta Interamericana (UAI),
        con el título intermedio de Analista de Sistemas ya en mano. Vengo combinando la formación académica con
        trabajo real: diseñé y desarrollé APIs REST con .NET Core y Node.js/Express, modelé bases de datos SQL y NoSQL,
        e implementé autenticación/autorización con JWT junto con buenas prácticas de seguridad como rate limiting y
        control de accesos por roles — todo esto tanto en proyectos de cátedra como en mi Trabajo Final de Ingeniería y
        mi Práctica Profesional Supervisada, donde trabajé con clientes reales.
      </p>
      <p>
        Estoy buscando mi primer rol junior en IT — desarrollo backend, análisis funcional o analista informático —
        donde pueda seguir creciendo dentro de un equipo, aportando lo que ya vengo construyendo en mis proyectos.
        Trabajo en Rosario, de forma presencial o híbrida.
      </p>
    </div>
  </section>

  <section class="section wrap" id="proyectos">
    <header class="section-head reveal"><span class="hour">02</span><h2>Proyectos</h2></header>
    {
      proyectosRender.map(({ p, Content }) => (
        <article class="project reveal">
          <div class="project-head">
            <h3>{p.data.title}</h3>
            <p class="project-status mono">
              {p.data.active && <span class="ember-dot" />}
              {p.data.status}
            </p>
          </div>
          <div class="project-body prose">
            <h2>Problema</h2>
            <p>{p.data.problem}</p>
            <div class="more" id={`more-${p.id}`} hidden>
              <Content />
            </div>
            <p class="stackline mono">{p.data.stack.join(' · ')}</p>
            <div class="links-row foot">
              <button type="button" class="toggle mono" aria-expanded="false" aria-controls={`more-${p.id}`}>
                Ver más
              </button>
              {p.data.links.map((l) => (
                <a href={l.href} target="_blank" rel="noopener" class="link-quiet">
                  {l.label}
                </a>
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <section class="section wrap" id="experiencia">
    <header class="section-head reveal"><span class="hour">03</span><h2>Experiencia</h2></header>
    {
      experienciaRender.map(({ e, Content }) => (
        <article class="entry reveal">
          <p class="entry-when mono">{e.data.when}</p>
          <div>
            <h3>{e.data.title}</h3>
            <p class="entry-where">{e.data.where}</p>
            <div class="prose">
              <Content />
            </div>
            {e.data.link && (
              <p class="foot">
                <a href={e.data.link.href} target="_blank" rel="noopener" class="link-quiet">
                  {e.data.link.label}
                </a>
              </p>
            )}
          </div>
        </article>
      ))
    }
  </section>

  <section class="section wrap" id="estudios">
    <header class="section-head reveal"><span class="hour">04</span><h2>Estudios</h2></header>
    <article class="entry reveal">
      <p class="entry-when mono">Último año</p>
      <div>
        <h3>Ingeniería en Sistemas</h3>
        <p class="entry-where">Universidad Abierta Interamericana (UAI) · Rosario</p>
        <div class="prose"><p>Trabajo Final de Ingeniería en curso: TourConnect.</p></div>
      </div>
    </article>
    <article class="entry reveal">
      <p class="entry-when mono">Título intermedio</p>
      <div>
        <h3>Analista de Sistemas</h3>
        <p class="entry-where">Universidad Abierta Interamericana (UAI)</p>
      </div>
    </article>
  </section>

  <section class="section wrap" id="stack">
    <header class="section-head reveal"><span class="hour">05</span><h2>Stack</h2></header>
    <dl class="stack">
      {
        stack.map((s) => (
          <div class="stack-row reveal">
            <dt class="mono">{s.k}</dt>
            <dd>{s.v}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="section wrap" id="contacto">
    <header class="section-head reveal"><span class="hour">06</span><h2>Contacto</h2></header>
    <p class="contact-big reveal">Hablemos.</p>
    <p class="page-lede reveal">Disponible para roles junior en desarrollo, datos o soporte. Rosario, presencial o híbrido.</p>
    <a class="contact-mail reveal" href="mailto:bautimarinelli100@gmail.com">bautimarinelli100@gmail.com</a>
  </section>
</Base>

<style>
  .boring-actions {
    margin-top: 2.2rem;
  }

  .boring-head {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    align-items: end;
    gap: clamp(2rem, 5vw, 4rem);
  }

  .boring-figure {
    max-width: 380px;
    justify-self: end;
    width: 100%;
  }

  @media (max-width: 760px) {
    .boring-head {
      grid-template-columns: 1fr;
    }

    .boring-figure {
      justify-self: start;
      max-width: 280px;
    }
  }

  .project {
    display: grid;
    grid-template-columns: minmax(200px, 1fr) 2fr;
    gap: clamp(1.5rem, 5vw, 4rem);
    padding-block: clamp(2.2rem, 5vw, 3.4rem);
    border-bottom: 1px solid var(--line);
  }

  .project:last-child,
  .entry:last-child {
    border-bottom: 0;
  }

  .project h3,
  .entry h3 {
    font-family: var(--serif-display);
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 1.15;
    font-variation-settings: "SOFT" 40;
  }

  .project h3 {
    font-size: clamp(1.9rem, 1.3rem + 2vw, 2.7rem);
  }

  .project-status {
    display: flex;
    align-items: baseline;
    gap: 0.55rem;
    margin-top: 0.7rem;
    font-size: 0.72rem;
    color: var(--fg-dim);
  }

  .ember-dot {
    flex: none;
    align-self: center;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    animation: smoulder 3.2s ease-in-out infinite;
  }

  @keyframes smoulder {
    0%, 100% { opacity: 1; }
    45% { opacity: 0.4; }
  }

  .project-body > h2:first-child {
    margin-top: 0;
  }

  .more {
    overflow: hidden;
  }

  .stackline {
    margin-top: 1.4rem;
    color: var(--fg-dim);
    line-height: 1.8;
  }

  .foot {
    margin-top: 1.4rem;
  }

  .toggle {
    background: none;
    border: 0;
    cursor: pointer;
    padding: 0;
    color: var(--fg-dim);
    transition: color 0.3s;
  }

  .toggle::before {
    content: "+ ";
    color: var(--accent);
  }

  .toggle[aria-expanded="true"]::before {
    content: "− ";
  }

  .toggle:hover {
    color: var(--fg);
  }

  .entry {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 2rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--line);
  }

  .entry-when {
    color: var(--fg-dim);
    padding-top: 0.45rem;
  }

  .entry h3 {
    font-size: clamp(1.35rem, 1.1rem + 0.9vw, 1.75rem);
  }

  .entry-where {
    margin-top: 0.3rem;
    margin-bottom: 1rem;
    font-style: italic;
    color: var(--fg-dim);
  }

  .stack-row {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 2rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--line);
  }

  .stack-row dt {
    color: var(--fg-dim);
    padding-top: 0.25rem;
  }

  .stack-row dd {
    font-family: var(--serif-display);
    font-size: clamp(1.15rem, 1rem + 0.6vw, 1.45rem);
    font-weight: 350;
  }

  .contact-big {
    font-family: var(--serif-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(3rem, 1.4rem + 7vw, 7rem);
    line-height: 1;
    letter-spacing: -0.03em;
    font-variation-settings: "SOFT" 100, "opsz" 144;
  }

  .contact-mail {
    display: inline-block;
    margin-top: 2rem;
    font-family: var(--serif-display);
    font-size: clamp(1.15rem, 0.8rem + 1.8vw, 2rem);
    text-decoration: none;
    overflow-wrap: anywhere;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 0.2rem;
    transition: border-color 0.5s var(--ease);
  }

  .contact-mail:hover {
    border-color: var(--accent);
  }

  @media (max-width: 760px) {
    .project,
    .entry,
    .stack-row {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }

    .project {
      gap: 1.4rem;
    }

    .entry-when {
      padding-top: 0;
    }
  }
</style>
