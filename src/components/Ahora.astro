---
// "Lo último": qué estoy leyendo, qué vi y el último post del blog.
// Sale solo de lo último de cada colección: no hay que mantenerlo aparte.
import { published, byDateDesc, formatDate, getPelis, getPosts } from '../lib/content';
import { route, ui, type Lang } from '../lib/i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'es' } = Astro.props;
const t = ui[lang];
const shelf = route('shelf', lang);

const [libros, pelis, posts] = await Promise.all([published('libros'), getPelis(), getPosts(lang)]);

// leyendo ahora; si no, el último con fecha
const reading = libros.find((l) => l.data.reading) ?? libros.filter((l) => l.data.date).sort(byDateDesc)[0];
const peli = pelis[0];
const post = posts[0];

const items = [
  reading && {
    label: reading.data.reading ? t.reading : t.lastRead,
    value: reading.data.title,
    sub: reading.data.author,
    href: `${shelf}#${reading.id}`,
    date: reading.data.date,
  },
  peli && {
    label: t.lastSeen,
    value: peli.title,
    sub: peli.line ?? [peli.director, peli.year].filter(Boolean).join(', '),
    href: `${shelf}#${peli.id}`,
    date: peli.date,
  },
  post && {
    label: `${t.onTheBlog} · ${post.label}`,
    value: post.title,
    sub: post.meta,
    href: post.href,
    date: post.date,
  },
].filter(Boolean) as Array<{ label: string; value: string; sub?: string; href: string; date?: Date }>;

const updated = items.reduce<Date | null>((max, i) => (i.date && (!max || i.date > max) ? i.date : max), null);
---

{
  items.length > 0 && (
    <div>
      <div class="now">
        {items.map((i) => (
          <div class="now-item reveal">
            <span class="now-label">{i.label}</span>
            <a class="now-value" href={i.href}>
              {i.value}
            </a>
            {i.sub && <span class="now-sub">{i.sub}</span>}
          </div>
        ))}
      </div>
      {updated && <p class="now-updated">{t.latestUpdated} {formatDate(updated, lang)}</p>}
    </div>
  )
}
