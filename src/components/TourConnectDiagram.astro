---
// Arquitectura de TourConnect (Trabajo Final de Ingeniería), en trazo de tinta para el tema de día.
// Sale del código del repo (server/index.js, middlewares/, routes/, models/, services/, utils/):
// React 19 + Vite; Express con un borde de seguridad y una cadena de middlewares por pedido;
// 12 grupos de rutas bajo /api/v1; MongoDB Atlas con 16 colecciones separadas por tenant;
// asistente (clasificador de intención → armado de consulta → Gemini o modo básico);
// Mercado Pago con webhook; auditoría con IP; correo con Nodemailer; PDF con pdfkit;
// tareas cada hora (vencimientos) y backup diario.
//
// En naranja, el recorrido de un pedido (con un pulso que avanza, salvo movimiento reducido).
interface Props {
  lang?: 'es' | 'en';
}
const { lang = 'es' } = Astro.props;

const t = {
  es: {
    title: 'Arquitectura de TourConnect',
    users: 'usuarios',
    roles: ['Mayorista', 'Agencia', 'Admin'],
    client: 'Cliente',
    clientSub: ['React 19 + Vite', 'vistas según el rol'],
    https: ['cookie', 'HttpOnly'],
    api: 'API REST',
    apiSub: 'Express · /api/v1',
    edge: 'helmet · CORS · sanitización · rate limit',
    chainLabel: 'cada pedido pasa por',
    chain: ['JWT en cookie', 'rol', 'tenant', 'permisos', 'límites del plan', 'oculta el markup a la agencia'],
    routesLabel: 'rutas',
    routes: ['auth', 'admin', 'mayoristas', 'agencias', 'productos', 'cotizaciones', 'reservas', 'reportes', 'asistente', 'auditoría', 'seguridad', 'webhooks'],
    db: 'MongoDB Atlas',
    dbSub: ['16 colecciones', 'datos separados por tenant'],
    tasks: 'Tareas automáticas',
    tasksSub: ['vencen cotizaciones y reservas', 'backup diario de la base'],
    services: [
      ['Asistente', 'clasificador de intención', '→ arma la consulta', 'Gemini o modo básico'],
      ['Mercado Pago', 'checkout (modo prueba)', 'webhook confirma', 'el pago y la reserva'],
      ['Auditoría', 'cada cambio registrado', 'quién, qué, cuándo', 'y desde qué IP'],
      ['Correo', 'Nodemailer', 'invitaciones, claves', 'y avisos'],
      ['PDF', 'pdfkit', 'reportes y', 'auditoría exportables'],
    ],
    webhook: 'webhook',
    direct: 'consulta directa, sin base vectorial',
    legendFlow: 'recorrido de un pedido',
    legendSide: 'consultas y eventos',
  },
  en: {
    title: 'TourConnect architecture',
    users: 'users',
    roles: ['Wholesaler', 'Agency', 'Admin'],
    client: 'Client',
    clientSub: ['React 19 + Vite', 'views by role'],
    https: ['HttpOnly', 'cookie'],
    api: 'REST API',
    apiSub: 'Express · /api/v1',
    edge: 'helmet · CORS · sanitizing · rate limit',
    chainLabel: 'every request goes through',
    chain: ['JWT in cookie', 'role', 'tenant', 'permissions', 'plan limits', 'hides markup from agencies'],
    routesLabel: 'routes',
    routes: ['auth', 'admin', 'wholesalers', 'agencies', 'products', 'quotes', 'bookings', 'reports', 'assistant', 'audit', 'security', 'webhooks'],
    db: 'MongoDB Atlas',
    dbSub: ['16 collections', 'data scoped per tenant'],
    tasks: 'Scheduled jobs',
    tasksSub: ['quotes and bookings expire', 'daily database backup'],
    services: [
      ['Assistant', 'intent classifier', '→ builds the query', 'Gemini or basic mode'],
      ['Mercado Pago', 'checkout (test mode)', 'webhook confirms', 'payment and booking'],
      ['Audit trail', 'every change recorded', 'who, what, when', 'and from which IP'],
      ['Email', 'Nodemailer', 'invites, passwords', 'and notices'],
      ['PDF', 'pdfkit', 'exportable reports', 'and audit logs'],
    ],
    webhook: 'webhook',
    direct: 'direct query, no vector database',
    legendFlow: 'path of a request',
    legendSide: 'queries and events',
  },
}[lang];

// geometría
const API = { x: 380, y: 20, w: 320, h: 360 };
const chainY = (i: number) => 128 + i * 24;
const routeCell = (i: number) => ({ x: 394 + (i % 4) * 74, y: 292 + Math.floor(i / 4) * 27 });
const svc = (i: number) => ({ x: 20 + i * 187, y: 446, w: 171, h: 92 });
const svcCx = (i: number) => svc(i).x + svc(i).w / 2;
const apiOut = [430, 495, 540, 585, 650]; // dónde sale cada flecha del borde de abajo de la API
---

<figure class="tc-diagram">
  <div class="tc-scroll">
    <svg viewBox="0 0 1000 600" role="img" aria-label={t.title}>
      <defs>
        <marker id="tc-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
          <path d="M 0 0 L 8 4 L 0 8" fill="none" stroke="currentColor" stroke-width="1.2"></path>
        </marker>
        <marker id="tc-arrow-hot" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
          <path d="M 0 0 L 8 4 L 0 8" fill="none" stroke="var(--accent)" stroke-width="1.3"></path>
        </marker>
      </defs>

      <!-- ===== trazos ===== -->
      <g fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round">
        <!-- usuarios -->
        {t.roles.map((_, i) => <rect x="20" y={78 + i * 50} width="120" height="34" rx="2" />)}
        {t.roles.map((_, i) => <path d={`M 140 ${95 + i * 50} C 160 ${95 + i * 50}, 160 145, 178 145`} marker-end="url(#tc-arrow)" opacity="0.55" />)}

        <!-- cliente -->
        <rect x="180" y="108" width="150" height="74" rx="2"></rect>

        <!-- API -->
        <rect x={API.x} y={API.y} width={API.w} height={API.h} rx="2" stroke-width="1.4"></rect>
        <rect x="394" y="70" width="292" height="22" rx="11" stroke-dasharray="2 3" opacity="0.7"></rect>
        {t.chain.map((_, i) => <rect x="414" y={chainY(i) - 14} width="252" height="19" rx="9.5" opacity="0.6" />)}
        {t.routes.map((_, i) => <rect x={routeCell(i).x} y={routeCell(i).y} width="70" height="21" rx="2" opacity="0.5" />)}

        <!-- base de datos -->
        <ellipse cx="855" cy="112" rx="95" ry="14"></ellipse>
        <path d="M 760 112 V 222 C 760 240, 950 240, 950 222 V 112"></path>
        <path d="M 760 150 C 760 168, 950 168, 950 150" opacity="0.35"></path>

        <!-- tareas automáticas -->
        <rect x="760" y="282" width="190" height="72" rx="2"></rect>
        <path d="M 855 282 L 855 244" stroke-dasharray="3 4" marker-end="url(#tc-arrow)" opacity="0.5"></path>

        <!-- servicios -->
        {t.services.map((_, i) => <rect x={svc(i).x} y={svc(i).y} width={svc(i).w} height={svc(i).h} rx="2" />)}
        {apiOut.map((x, i) => (
          <path d={`M ${x} ${API.y + API.h} C ${x} 414, ${svcCx(i)} 410, ${svcCx(i)} 444`} marker-end="url(#tc-arrow)" opacity="0.5" />
        ))}

        <!-- el asistente consulta MongoDB directo: por abajo y por la derecha -->
        <path d="M 105 538 L 105 560 L 975 560 L 975 190 L 954 190" stroke-dasharray="3 4" marker-end="url(#tc-arrow)" opacity="0.45"></path>
      </g>

      <!-- recorrido de un pedido, en naranja -->
      <g fill="none" stroke="var(--accent)" stroke-width="1.4" stroke-linecap="round">
        <path d="M 330 145 L 378 145" marker-end="url(#tc-arrow-hot)"></path>
        <path d="M 404 124 L 404 262" opacity="0.8"></path>
        {t.chain.map((_, i) => <circle cx="404" cy={chainY(i) - 4.5} r="2.6" fill="var(--accent)" stroke="none" />)}
        <path d="M 404 262 L 404 274 L 539 274 L 539 290" marker-end="url(#tc-arrow-hot)" opacity="0.8"></path>
        <path d="M 700 180 L 756 180" marker-end="url(#tc-arrow-hot)"></path>
        <!-- pulso que avanza -->
        <path class="tc-pulse" d="M 330 145 L 404 145 L 404 274 L 539 274 L 539 290 M 700 180 L 756 180" stroke-width="2.2"></path>
        <!-- webhook de vuelta, de Mercado Pago a la API -->
        <path d="M 330 446 C 330 420, 620 412, 620 382" stroke-dasharray="4 4" marker-end="url(#tc-arrow-hot)" opacity="0.75"></path>
      </g>

      <!-- ===== textos ===== -->
      <g class="tc-text" fill="currentColor">
        <text x="80" y="64" text-anchor="middle" class="tc-kicker">{t.users}</text>
        {t.roles.map((r, i) => <text x="80" y={100 + i * 50} text-anchor="middle" class="tc-label">{r}</text>)}

        <text x="255" y="138" text-anchor="middle" class="tc-title">{t.client}</text>
        {t.clientSub.map((s, i) => <text x="255" y={156 + i * 14} text-anchor="middle" class="tc-sub">{s}</text>)}
        {t.https.map((s, i) => <text x="355" y={124 + i * 12} text-anchor="middle" class="tc-hot">{s}</text>)}

        <text x="540" y="46" text-anchor="middle" class="tc-title tc-big">{t.api}</text>
        <text x="540" y="62" text-anchor="middle" class="tc-sub">{t.apiSub}</text>
        <text x="540" y="85" text-anchor="middle" class="tc-chip">{t.edge}</text>
        <text x="540" y="109" text-anchor="middle" class="tc-kicker">{t.chainLabel}</text>
        {t.chain.map((c, i) => <text x="540" y={chainY(i)} text-anchor="middle" class="tc-chip">{i + 1} · {c}</text>)}
        <text x="394" y="287" class="tc-kicker">{t.routesLabel}</text>
        {t.routes.map((r, i) => <text x={routeCell(i).x + 35} y={routeCell(i).y + 14} text-anchor="middle" class="tc-chip tc-route">{r}</text>)}

        <text x="728" y="172" text-anchor="middle" class="tc-sub">Mongoose</text>
        <text x="855" y="190" text-anchor="middle" class="tc-title">{t.db}</text>
        {t.dbSub.map((s, i) => <text x="855" y={206 + i * 13} text-anchor="middle" class="tc-sub">{s}</text>)}

        <text x="855" y="306" text-anchor="middle" class="tc-title">{t.tasks}</text>
        {t.tasksSub.map((s, i) => <text x="855" y={324 + i * 14} text-anchor="middle" class="tc-sub">{s}</text>)}

        {
          t.services.map(([title, ...lines], i) => (
            <>
              <text x={svcCx(i)} y={svc(i).y + 26} text-anchor="middle" class="tc-title">{title}</text>
              {lines.map((l, j) => (
                <text x={svcCx(i)} y={svc(i).y + 46 + j * 14} text-anchor="middle" class="tc-sub">{l}</text>
              ))}
            </>
          ))
        }
        <text x="403" y="438" class="tc-hot">{t.webhook}</text>
        <text x="540" y="574" text-anchor="middle" class="tc-sub">{t.direct}</text>

        <!-- leyenda -->
        <line x1="20" y1="592" x2="44" y2="592" stroke="var(--accent)" stroke-width="1.4"></line>
        <text x="52" y="595" class="tc-sub">{t.legendFlow}</text>
        <line x1="210" y1="592" x2="234" y2="592" stroke="currentColor" stroke-dasharray="3 4" opacity="0.6"></line>
        <text x="242" y="595" class="tc-sub">{t.legendSide}</text>
      </g>
    </svg>
  </div>
</figure>

<style>
  .tc-diagram {
    margin-block: clamp(2.4rem, 6vw, 4rem);
    color: var(--fg);
  }

  /* en pantallas chicas el diagrama se desliza de costado en vez de achicarse hasta no leerse */
  .tc-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }

  .tc-scroll svg {
    display: block;
    width: 100%;
    min-width: 760px;
    height: auto;
  }

  .tc-title {
    font-family: var(--serif-display);
    font-size: 15px;
  }

  .tc-big {
    font-size: 19px;
  }

  .tc-label {
    font-family: var(--mono);
    font-size: 11px;
  }

  .tc-sub {
    font-family: var(--mono);
    font-size: 10px;
    opacity: 0.65;
  }

  .tc-chip {
    font-family: var(--mono);
    font-size: 9.5px;
  }

  .tc-route {
    font-size: 8.8px;
  }

  .tc-kicker {
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.5;
  }

  .tc-hot {
    font-family: var(--mono);
    font-size: 9px;
    fill: var(--accent);
  }

  /* un pulso corto que recorre el camino de un pedido */
  .tc-pulse {
    stroke-dasharray: 14 520;
    animation: tc-pulse 3.6s linear infinite;
  }

  @keyframes tc-pulse {
    to {
      stroke-dashoffset: -534;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tc-pulse {
      display: none;
    }
  }

  @media print {
    .tc-pulse {
      display: none;
    }
  }
</style>
