---
import { formatDate, formatMonth, monthKey, type LogItem } from '../lib/content';
import { ui, type Lang } from '../lib/i18n';

interface Props {
  items: LogItem[];
  /** agrupar por mes (en /blog) */
  grouped?: boolean;
  lang?: Lang;
}

const { items, grouped = false, lang = 'es' } = Astro.props;
const t = ui[lang];

// para agrupar: insertar un encabezado cada vez que cambia el mes
const rows: Array<{ month: string; label: string } | LogItem> = [];
let lastMonth = '';
for (const it of items) {
  const key = monthKey(it.date);
  if (grouped && key !== lastMonth) {
    rows.push({ month: key, label: formatMonth(it.date, lang) });
    lastMonth = key;
  }
  rows.push(it);
}
---

{
  items.length === 0 ? (
    <p class="empty">{t.empty}</p>
  ) : (
    <ul class="log">
      {rows.map((r) =>
        'month' in r ? (
          <li class="log-month" data-month={r.month}>
            {r.label}
          </li>
        ) : (
          <li class="log-item reveal" data-type={r.kind} data-month-of={monthKey(r.date)}>
            <time class="log-date" datetime={r.date.toISOString().slice(0, 10)}>
              {formatDate(r.date, lang)}
            </time>
            <span class="log-type">{r.label}</span>
            <div class="log-body">
              <a class="log-title" href={r.href}>
                {r.title}
              </a>
              {r.meta && <span class="log-meta">{r.meta}</span>}
            </div>
            {r.draft && <span class="log-draft">{t.draft}</span>}
          </li>
        ),
      )}
    </ul>
  )
}
