---
import { Image } from 'astro:assets';
// El estante, en castellano (/estante) o en inglés (/en/shelf).
import Base from '../../layouts/Base.astro';
import { published, byDateDesc, formatDate, getPelis } from '../../lib/content';
import { LETTERBOXD_USER } from '../../content.config';
import { ui, type Lang } from '../../lib/i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];

const pelis = await getPelis();
// leyendo ahora → con fecha (más nuevo primero) → sin fecha (por apellido)
const surname = (author: string) => author.trim().split(/\s+/).pop() ?? author;
const libros = (await published('libros')).sort(
  (a, b) =>
    Number(b.data.reading) - Number(a.data.reading) ||
    byDateDesc(a, b) ||
    surname(a.data.author).localeCompare(surname(b.data.author), 'es') ||
    (a.data.year ?? 0) - (b.data.year ?? 0),
);
---

<Base title={t.shelfTitle} current="estante" nightStart={0.3} fire={0.55} lang={lang}>
  <header class="page-head wrap">
    <p class="page-kicker">01:50</p>
    <h1 class="page-title">{t.shelfTitle}</h1>
    <p class="page-lede">
      {t.shelfLede} <a href={`https://letterboxd.com/${LETTERBOXD_USER}/`} target="_blank" rel="noopener">Letterboxd</a>.
    </p>
  </header>

  <div class="wrap shelves">
    <section aria-labelledby="pelis">
      <header class="section-head reveal">
        <span class="hour">{t.films}</span>
        <h2 id="pelis">{t.filmsTitle}</h2>
      </header>
      {pelis.length === 0 && <p class="empty">{t.nothingYet}</p>}
      <ol class="shelf">
        {
          pelis.map((p) => (
            <li class="shelf-item reveal" id={p.id}>
              <span class="shelf-year mono">{p.year}</span>
              <div>
                <p class="shelf-title">
                  {p.url ? (
                    <a href={p.url} target="_blank" rel="noopener">
                      {p.title}
                    </a>
                  ) : (
                    p.title
                  )}
                </p>
                {(p.director || p.rewatch) && (
                  <p class="shelf-by">{[p.director, p.rewatch && t.again].filter(Boolean).join(' · ')}</p>
                )}
                {p.line && <p class="shelf-line">{p.line}</p>}
              </div>
              <span class="shelf-when mono">
                {formatDate(p.date, lang)}
                {p.draft && <span class="log-draft">{t.draft}</span>}
              </span>
              {typeof p.poster === 'string' ? (
                <img class="shelf-poster" src={p.poster} alt="" width="180" height="270" loading="lazy" decoding="async" />
              ) : (
                p.poster && <Image class="shelf-poster" src={p.poster} alt="" width={180} />
              )}
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="libros">
      <header class="section-head reveal">
        <span class="hour">{t.books}</span>
        <h2 id="libros">{t.booksTitle}</h2>
      </header>
      {libros.length === 0 && <p class="empty">{t.nothingYet}</p>}
      <ol class="shelf">
        {
          libros.map((l) => (
            <li class="shelf-item reveal" id={l.id}>
              <span class="shelf-year mono">{l.data.year ?? '—'}</span>
              <div>
                <p class="shelf-title">{l.data.title}</p>
                <p class="shelf-by">{l.data.author}</p>
                {l.data.line && <p class="shelf-line">{l.data.line}</p>}
              </div>
              <span class="shelf-when mono">
                {l.data.reading ? <em class="reading">{t.readingNow}</em> : l.data.date ? formatDate(l.data.date, lang) : ''}
                {l.data.draft && <span class="log-draft">{t.draft}</span>}
              </span>
              {l.data.cover && <Image class="shelf-poster" src={l.data.cover} alt="" width={180} />}
            </li>
          ))
        }
      </ol>
    </section>
  </div>
</Base>

<style>
  .shelves {
    display: grid;
    gap: clamp(4rem, 10vw, 7rem);
  }

  .shelf {
    list-style: none;
  }

  .shelf-item {
    position: relative;
    display: grid;
    grid-template-columns: 4rem 1fr auto;
    align-items: baseline;
    gap: 1.4rem;
    padding-block: 1.3rem;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 6rem;
  }

  .shelf-item:target {
    background: linear-gradient(90deg, rgba(255, 138, 61, 0.08), transparent 70%);
  }

  .shelf-year,
  .shelf-when {
    color: var(--fg-dim);
  }

  .shelf-when {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    text-align: right;
  }

  .shelf-title {
    font-family: var(--serif-display);
    font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.8rem);
    font-weight: 360;
    line-height: 1.15;
    font-variation-settings: "SOFT" 60;
  }

  .shelf-title a {
    text-decoration: none;
    transition: color 0.3s;
  }

  .shelf-title a:hover {
    color: var(--warm);
  }

  .page-lede a {
    color: var(--fg);
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
  }

  .page-lede a:hover {
    text-decoration-color: var(--accent);
  }

  .shelf-by {
    font-style: italic;
    color: var(--fg-dim);
  }

  .shelf-line {
    margin-top: 0.5rem;
    max-width: 56ch;
  }

  .reading {
    color: var(--accent);
    font-style: normal;
  }

  /* el póster aparece al pasar, como sacándolo del estante */
  .shelf-item :global(.shelf-poster) {
    position: absolute;
    right: 12rem;
    top: 50%;
    width: 110px;
    height: auto;
    opacity: 0;
    transform: translateY(-46%) rotate(-2deg);
    pointer-events: none;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
    transition: opacity 0.5s var(--ease), transform 0.7s var(--ease);
  }

  .shelf-item:hover :global(.shelf-poster) {
    opacity: 1;
    transform: translateY(-50%) rotate(-1deg);
  }

  @media (max-width: 640px) {
    .shelf-item {
      grid-template-columns: 1fr auto;
      gap: 0.2rem 1rem;
    }

    .shelf-year {
      grid-row: 1;
    }

    .shelf-item > div {
      grid-column: 1 / -1;
    }

    .shelf-when {
      grid-row: 1;
      grid-column: 2;
    }

    .shelf-item :global(.shelf-poster) {
      display: none;
    }
  }
</style>
